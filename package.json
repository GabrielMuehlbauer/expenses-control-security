{
  "name": "expenses-control-security",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "start": "npm start -w apps/api",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint --workspaces",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "test": "npm test -w apps/api",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@playwright/test": "^1.56.1"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
