  "description": "O Expenses Control é uma API RESTful desenvolvida em Node.js focada no gerenciamento de finanças pessoais.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 test/*.test.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/database/migrate.js",
    "lint": "eslint src test",
    "db:seed": "node src/database/seed.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielMuehlbauer/expenses-control-security.git"
  },
